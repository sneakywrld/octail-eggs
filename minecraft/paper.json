      "default_value": "latest",
      "user_viewable": true,
      "user_editable": true,
      "rules": [
        "required",
        "string",
        "max:20",
        "regex:/^(latest|[0-9]+)$/"
      ]
    },
    {
      "sort": 3,
      "name": "Download Path",
      "description": "Staff only: an https:// address to download the server jar from instead of PaperMC, such as a mirror. {{MINECRAFT_VERSION}}, {{BUILD_NUMBER}} and {{PROJECT}} in it are filled in. Nothing is published to check that jar against, so the install only checks that it is a jar.",
      "env_variable": "DL_PATH",
      "default_value": "",
      "user_viewable": false,
      "user_editable": false,
      "rules": [
        "nullable",
        "string",
        "max:500"
      ]
    },
    {
      "sort": 1,
      "name": "Minecraft Version",
      "description": "The Minecraft version to install, such as 1.21.11, or latest for the newest version with a stable Paper build. A version Paper has no build for fails the install.\n\nThe Startup image must fit it: Java 25 for the newest releases, Java 21 for 1.20.5 to 1.21.x, Java 17 for 1.17 to 1.20.4, Java 8 or 11 before that.",
      "env_variable": "MINECRAFT_VERSION",
      "default_value": "latest",
      "user_viewable": true,
      "user_editable": true,
      "rules": [
        "nullable",
        "string",
        "max:32",
        "regex:/^(latest|[0-9A-Za-z.-]+)$/"
      ]
    },
    {
      "sort": 6,
      "name": "Project",
      "description": "Staff only: the PaperMC project to download (paper).",
      "env_variable": "PROJECT",
      "default_value": "paper",
      "user_viewable": false,
      "user_editable": false,
      "rules": [
        "required",
        "string",
        "regex:/^[a-z]+$/"
      ]
    },
    {
      "sort": 2,
      "name": "Server Jar File",
      "description": "The name of the server jarfile to run the server with.",
      "env_variable": "SERVER_JARFILE",
      "default_value": "server.jar",
      "user_viewable": true,
      "user_editable": true,
      "rules": [
        "required",
        "regex:/^([\\w\\d._-]+)(\\.jar)$/"
      ]
    },
    {
      "sort": 5,
      "name": "User Agent",
      "description": "Required to use the paper fill API.\nSee https://docs.papermc.io/misc/downloads-service/",
      "env_variable": "USER_AGENT",
      "default_value": "",
      "user_viewable": false,
      "user_editable": false,
      "rules": [
        "required"
      ]
    }
  ],
