  "scripts": {
    "installation": {
      "script": "#!/bin/ash\n# Paper installation (Octail): the jar from PaperMC's download service (Fill API v3), its SHA-256 checked.\n# \"latest\" picks the newest Minecraft version with a stable Paper build (the newest one when none is stable\n# yet), so a release candidate isn't installed by default. A version or build that doesn't exist fails the\n# install instead of installing another one. Staff can point Download Path at their own jar instead (HTTPS\n# only; nothing is published to check it against).\n#\n# Server files: /mnt/server\nset -eu\n\nPROJECT=\"${PROJECT:-paper}\"\nAPI=\"https://fill.papermc.io/v3/projects/${PROJECT}\"\nJAR=\"${SERVER_JARFILE:-server.jar}\"\nVERSION=\"${MINECRAFT_VERSION:-latest}\"\nBUILD=\"${BUILD_NUMBER:-latest}\"\n\nfail() {\n\techo \"Install failed: $*\"\n\texit 1\n}\n\ncase \"${PROJECT}\" in\n'' | *[!a-z]*) fail \"the project (${PROJECT}) must be a PaperMC project name such as paper\" ;;\nesac\nif [ -z \"${USER_AGENT:-}\" ]; then\n\tfail \"PaperMC's download service needs a User-Agent: staff set the egg's User Agent variable (see https://docs.papermc.io/misc/downloads-service/)\"\nfi\nget() { curl -fsSL --retry 3 --connect-timeout 20 -H \"User-Agent: ${USER_AGENT}\" \"$1\"; }\n\nmkdir -p /mnt/server\ncd /mnt/server\n\nif [ -n \"${DL_PATH:-}\" ]; then\n\t# A staff-set address; {{MINECRAFT_VERSION}}, {{BUILD_NUMBER}} and {{PROJECT}} in it are filled in.\n\tURL=$(echo \"${DL_PATH}\" | sed \\\n\t\t-e \"s|{{PROJECT}}|${PROJECT}|g\" \\\n\t\t-e \"s|{{MINECRAFT_VERSION}}|${VERSION}|g\" \\\n\t\t-e \"s|{{BUILD_NUMBER}}|${BUILD}|g\")\n\tcase \"${URL}\" in\n\thttps://*) ;;\n\t*) fail \"Download Path must be an https:// address\" ;;\n\tesac\n\techo \"Installing ${JAR} from the Download Path set by staff (no checksum to check it against)\"\n\trm -f \"${JAR}.download\"\n\tget \"${URL}\" >\"${JAR}.download\" || fail \"the download from ${URL} failed\"\n\tif [ \"$(head -c 2 \"${JAR}.download\")\" != \"PK\" ]; then\n\t\trm -f \"${JAR}.download\"\n\t\tfail \"the file at ${URL} is not a jar\"\n\tfi\n\tif [ -f \"${JAR}\" ]; then\n\t\tmv -f \"${JAR}\" \"${JAR}.old\"\n\tfi\n\tmv \"${JAR}.download\" \"${JAR}\"\n\techo \"Installed ${JAR} from the Download Path.\"\n\techo \"Accepting the Minecraft EULA (https://aka.ms/MinecraftEULA) is the server owner's decision: the panel asks on the first start.\"\n\texit 0\nfi\n\nPROJECT_JSON=$(get \"${API}\") || fail \"can't reach PaperMC's download service (${API})\"\n# Newest first: the version groups (\"26.3\", \"1.21\", ...) and the versions in each.\nALL=$(echo \"${PROJECT_JSON}\" | jq -r '.versions | to_entries[] | .value[]')\n[ -n \"${ALL}\" ] || fail \"PaperMC lists no ${PROJECT} versions\"\n\nif [ -z \"${VERSION}\" ] || [ \"${VERSION}\" = \"latest\" ]; then\n\tVERSION=\"\"\n\tfor v in ${ALL}; do\n\t\tCHANNEL=$(get \"${API}/versions/${v}/builds/latest\" | jq -r '.channel // empty') || CHANNEL=\"\"\n\t\tif [ \"${CHANNEL}\" = \"STABLE\" ] || [ \"${CHANNEL}\" = \"RECOMMENDED\" ]; then\n\t\t\tVERSION=\"${v}\"\n\t\t\tbreak\n\t\tfi\n\tdone\n\tif [ -z \"${VERSION}\" ]; then\n\t\tVERSION=$(echo \"${ALL}\" | head -n 1)\n\t\techo \"No Minecraft version has a stable ${PROJECT} build yet; using ${VERSION}.\"\n\tfi\nfi\necho \"${ALL}\" | grep -qxF \"${VERSION}\" ||\n\tfail \"${PROJECT} has no Minecraft ${VERSION}. The versions are listed at https://papermc.io/downloads/${PROJECT}\"\n\nif [ -z \"${BUILD}\" ] || [ \"${BUILD}\" = \"latest\" ]; then\n\tBUILD_URL=\"${API}/versions/${VERSION}/builds/latest\"\nelse\n\tcase \"${BUILD}\" in\n\t*[!0-9]*) fail \"the build number (${BUILD}) must be a number or latest\" ;;\n\tesac\n\tBUILD_URL=\"${API}/versions/${VERSION}/builds/${BUILD}\"\nfi\nINFO=$(get \"${BUILD_URL}\") || fail \"${PROJECT} has no build ${BUILD} for ${VERSION}\"\nBUILD=$(echo \"${INFO}\" | jq -r '.id // empty')\nCHANNEL=$(echo \"${INFO}\" | jq -r '.channel // empty')\nURL=$(echo \"${INFO}\" | jq -r '.downloads.\"server:default\".url // empty')\nSHA256=$(echo \"${INFO}\" | jq -r '.downloads.\"server:default\".checksums.sha256 // empty' | tr 'A-F' 'a-f')\ncase \"${URL}\" in\nhttps://*) ;;\n*) fail \"PaperMC gave no download for ${PROJECT} ${VERSION} build ${BUILD}\" ;;\nesac\necho \"${SHA256}\" | grep -Eq '^[0-9a-f]{64}$' || fail \"PaperMC gave no SHA-256 for ${PROJECT} ${VERSION} build ${BUILD}\"\nif [ \"${CHANNEL}\" != \"STABLE\" ] && [ \"${CHANNEL}\" != \"RECOMMENDED\" ]; then\n\techo \"Note: ${PROJECT} ${VERSION} build ${BUILD} is marked ${CHANNEL}, not stable.\"\nfi\n\necho \"Installing ${PROJECT} ${VERSION} build ${BUILD} as ${JAR}\"\nrm -f \"${JAR}.download\"\ncurl -fsSL --retry 3 --connect-timeout 20 -H \"User-Agent: ${USER_AGENT}\" -o \"${JAR}.download\" \"${URL}\" ||\n\tfail \"the download of ${PROJECT} ${VERSION} build ${BUILD} failed\"\nGOT=$(sha256sum \"${JAR}.download\" | cut -d ' ' -f 1)\nif [ \"${GOT}\" != \"${SHA256}\" ]; then\n\trm -f \"${JAR}.download\"\n\tfail \"SHA-256 mismatch for ${PROJECT} ${VERSION} build ${BUILD} (expected ${SHA256}, got ${GOT})\"\nfi\nif [ -f \"${JAR}\" ]; then\n\tmv -f \"${JAR}\" \"${JAR}.old\"\nfi\nmv \"${JAR}.download\" \"${JAR}\"\n\necho \"${PROJECT} ${VERSION} build ${BUILD} installed (SHA-256 checked).\"\necho \"Accepting the Minecraft EULA (https://aka.ms/MinecraftEULA) is the server owner's decision: the panel asks on the first start.\"",
      "container": "ghcr.io/sneakywrld/octail-yolks:installer_alpine",
      "entrypoint": "ash"
    }
  },
  "variables": [
    {
      "sort": 4,
      "name": "Build Number",
      "description": "The Paper build to install, or latest for the newest build of that Minecraft version. A build that does not exist fails the install.",
