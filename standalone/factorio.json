  "file_denylist": {},
  "startup_commands": {
    "Default": "[ ! -f \"./saves/{{SAVE_NAME}}.zip\" ] && ./bin/x64/factorio --create ./saves/{{SAVE_NAME}}.zip --map-gen-settings data/map-gen-settings.json --map-settings data/map-settings.json; ./bin/x64/factorio --port {{SERVER_PORT}} --server-settings data/server-settings.json --start-server saves/{{SAVE_NAME}}.zip $( [ \"$RCON_ENABLED\" = \"1\" ] && echo \"--rcon-port {{RCON_PORT}} --rcon-password {{RCON_PASSWORD}}\" )"
  },
  "config": {
    "files": {
      "data/server-settings.json": {
        "parser": "json",
        "find": {
          "name": "{{server.environment.SERVER_NAME}}",
          "description": "{{server.environment.SERVER_DESC}}",
          "max_players": "{{server.environment.MAX_SLOTS}}",
          "username": "{{server.environment.SERVER_USERNAME}}",
          "token": "{{server.environment.SERVER_TOKEN}}",
          "autosave_interval": "{{server.environment.SAVE_INTERVAL}}",
          "autosave_slots": "{{server.environment.SAVE_SLOTS}}",
          "afk_autokick_interval": "{{server.environment.AFK_KICK}}",
          "game_password": "{{server.environment.SERVER_PASSWORD}}"
        }
      }
    },
    "startup": {
      "done": "Hosting game at"
    },
    "logs": {},
    "stop": "/quit"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# Factorio installation script (pelican-eggs, changed for Octail: the headless server checked against the SHA-256\n# list factorio.com publishes, failures exit non-zero, a reinstall keeps your settings and saves)\n#\n# Server Files: /mnt/server\nset -euo pipefail\napt-get update -qq\napt-get install -y -qq curl tar xz-utils jq ca-certificates > /dev/null\n\nif [ \"$(uname -m)\" != x86_64 ]; then\n    echo \"Installation failed: this egg installs Factorio's Linux x86_64 headless server (this node is $(uname -m)).\"\n    exit 1\nfi\n\nSAVE_NAME=\"${SAVE_NAME:-gamesave}\"\n\n## latest = the newest stable headless release, experimental = the newest experimental one, or a version such as 2.0.72\nVERSION=\"${FACTORIO_VERSION:-latest}\"\ncase \"$VERSION\" in\n    latest | experimental)\n        CHANNEL=stable\n        [ \"$VERSION\" = experimental ] && CHANNEL=experimental\n        VERSION=$(curl -fsSL --retry 3 https://factorio.com/api/latest-releases | jq -r \".${CHANNEL}.headless // empty\" || true)\n        if [ -z \"$VERSION\" ]; then\n            echo \"Installation failed: the newest Factorio version couldn't be read from factorio.com.\"\n            exit 1\n        fi\n        ;;\nesac\n\n## factorio.com lists the SHA-256 of every release; the headless file is named factorio-headless_linux_<version>.tar.xz\n## (2.0 and newer) or factorio_headless_x64_<version>.tar.xz (older)\nSUM=$(curl -fsSL --retry 3 https://www.factorio.com/download/sha256sums/ | awk -v a=\"factorio-headless_linux_${VERSION}.tar.xz\" -v b=\"factorio_headless_x64_${VERSION}.tar.xz\" '$2 == a || $2 == b { print tolower($1); exit }' || true)\nif [ -z \"$SUM\" ]; then\n    echo \"Installation failed: Factorio ${VERSION} isn't in factorio.com's SHA-256 list (check the version).\"\n    exit 1\nfi\n\nmkdir -p /mnt/server\ncd /mnt/server\n## downloaded into the server folder (the installer's /tmp is small), removed afterwards\nDL=/mnt/server/.factorio-download.tar.xz\necho \"Downloading Factorio ${VERSION} (headless)\"\nif ! curl -fsSL --retry 3 -o \"$DL\" \"https://www.factorio.com/get-download/${VERSION}/headless/linux64\"; then\n    rm -f \"$DL\"\n    echo \"Installation failed: the download of Factorio ${VERSION} failed.\"\n    exit 1\nfi\nif ! echo \"${SUM}  ${DL}\" | sha256sum -c --quiet -; then\n    rm -f \"$DL\"\n    echo \"Installation failed: the download doesn't match factorio.com's SHA-256.\"\n    exit 1\nfi\ntar -xJf \"$DL\" --strip-components=1 -C /mnt/server\nrm -f \"$DL\"\nif [ ! -x /mnt/server/bin/x64/factorio ]; then\n    echo \"Installation failed: bin/x64/factorio is missing after unpacking Factorio ${VERSION}.\"\n    exit 1\nfi\n\n## the settings files, only when there are none (a reinstall keeps yours)\nfor f in map-gen-settings server-settings map-settings; do\n    if [ -e \"data/${f}.json\" ]; then\n        echo \"data/${f}.json exists\"\n    else\n        echo \"copying the default data/${f}.json\"\n        cp \"data/${f}.example.json\" \"data/${f}.json\"\n    fi\ndone\n\nmkdir -p saves\nif [ -e \"./saves/${SAVE_NAME}.zip\" ]; then\n    echo \"save file exists\"\nelse\n    ./bin/x64/factorio --create \"./saves/${SAVE_NAME}\" --map-gen-settings data/map-gen-settings.json --map-settings data/map-settings.json\n    chmod o+w \"./saves/${SAVE_NAME}.zip\"\nfi\n\n## install end\necho \"-----------------------------------------\"\necho \"Installation completed: Factorio ${VERSION}.\"\necho \"-----------------------------------------\"\n",
      "container": "ghcr.io/sneakywrld/octail-yolks:installer_debian",
      "entrypoint": "bash"
    }
  },
