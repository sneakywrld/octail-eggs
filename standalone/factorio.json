  "x_octail": {
    "category": "Factorio",
    "features": {
      "rcon": {
        "type": "factorio",
        "port_var": "RCON_PORT",
        "password_var": "RCON_PASSWORD"
      },
      "port_vars": {
        "RCON_PORT": "primary+1"
      },
      "players": {
        "list": "factorio_rcon",
        "kick": "/kick {name} {reason}",
        "ban": "/ban {name} {reason}",
        "unban": "/unban {name}"
      },
      "sleep": {
        "mode": "udp"
      },
      "broadcast_command": "{message}",
      "install_sandbox": {
        "network": "internet",
        "timeout_s": 1800
      },
      "resources": {
        "memory_mb": 2048,
        "disk_mb": 5120
      }
    },
    "variables": {
