{
  "_comment": "Octail curated egg (plan §6.4). Based on games-steamcmd craftopia/egg-craftopia.yaml (pelican-eggs, MIT licence), converted to JSON. Octail fixes the image name (upstream: pelican-egggs), downloads ServerSetting.ini from the pinned commit instead of refs/heads/main (a failed download fails the install), and adds the craftopia tag, max players and difficulty written to ServerSetting.ini (ini parser), an optional password (a PIN of up to 8 digits; usePassword follows it), install sandbox defaults and resource hints, drops the update URL (pinned), starts the server with -batchmode -showlogs (as LinuxGSM does; without -showlogs the game's own log, which has the \"World is loaded!\" start line, does not reach the console), and makes the install fail when SteamCMD didn't download the server. SteamCMD is retried up to 3 times: its first run on a fresh install often fails with \"Missing configuration\". The start also counts once the game port is bound, UDP or TCP (x_octail.features.ready, proto any: hosts open 6587 for both and the game does not document which it uses): the game draws a full-screen console and \"World is loaded!\" often never shows.",
  "meta": {
    "version": "PLCN_v3",
    "update_url": "https://raw.githubusercontent.com/sneakywrld/octail-eggs/main/steam/craftopia.json"
  },
  "exported_at": "2026-06-08T08:13:53+00:00",
  "name": "Craftopia",
  "author": "eggs@goover.dev",
  "uuid": "6304c348-83aa-420a-aa84-15a52d995964",
  "description": "Craftopia is the brand new multiplayer survival action game made in Japan. We combined many features\nwe find enjoyable, such as hunting, farming, hack-and-slash, building, automation to develop this\ngame.",
  "icon": "data:image/jpeg;base64,",
  "tags": [
    "craftopia",
    "steamcmd"
  ],
  "features": [
    "steam_disk_space"
  ],
  "docker_images": {
    "SteamCMD Debian": "ghcr.io/sneakywrld/octail-yolks:steamcmd_debian"
  },
  "file_denylist": {},
  "startup_commands": {
    "Default": "if [ -n \"${SERVER_PASSWORD}\" ]; then sed -i -e 's/^usePassword=.*/usePassword=1/' -e \"s/^serverPassword=.*/serverPassword=${SERVER_PASSWORD}/\" ServerSetting.ini; else sed -i 's/^usePassword=.*/usePassword=0/' ServerSetting.ini; fi; ./Craftopia.x86_64 -batchmode -showlogs"
  },
  "config": {
    "files": {
      "ServerSetting.ini": {
        "parser": "ini",
        "find": {
          "GameWorld.name": "{{server.environment.WORLD_NAME}}",
          "Host.port": "{{server.allocations.default.port}}",
          "Host.maxPlayerNumber": "{{server.environment.MAX_PLAYERS}}",
          "GameWorld.difficulty": "{{server.environment.DIFFICULTY}}"
        }
      }
    },
    "startup": {
      "done": "World is loaded!"
    },
    "logs": {},
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\n# steamcmd Base Installation Script\n#\n# Server Files: /mnt/server\n# Image to install with is 'ghcr.io/parkervcp/installers:debian'\n\n##\n\n## just in case someone removed the defaults.\nif [[ \"${STEAM_USER}\" == \"\" ]] || [[ \"${STEAM_PASS}\" == \"\" ]]; then\n    echo -e \"steam user is not set.\\n\"\n    echo -e \"Using anonymous user.\\n\"\n    STEAM_USER=anonymous\n    STEAM_PASS=\"\"\n    STEAM_AUTH=\"\"\nelse\n    echo -e \"user set to ${STEAM_USER}\"\nfi\n\n## download and install steamcmd\ncd /tmp\nmkdir -p /mnt/server/steamcmd\ncurl -sSL -o steamcmd.tar.gz https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz\ntar -xzvf steamcmd.tar.gz -C /mnt/server/steamcmd\nmkdir -p /mnt/server/steamapps # Fix steamcmd disk write error when this folder is missing\ncd /mnt/server/steamcmd\n\n# SteamCMD fails otherwise for some reason, even running as root.\n# This is changed at the end of the install process anyways.\nchown -R root:root /mnt\nexport HOME=/mnt/server\n\n## install game using steamcmd\n## Octail: SteamCMD's first run often fails with \"Missing configuration\"; try up to 3 times\nfor steamcmd_try in 1 2 3; do\n    if ./steamcmd.sh +force_install_dir /mnt/server +login ${STEAM_USER} ${STEAM_PASS} ${STEAM_AUTH} $( [[ \"${WINDOWS_INSTALL}\" == \"1\" ]] && printf %s '+@sSteamCmdForcePlatformType windows' ) +app_update ${SRCDS_APPID} $( [[ -z ${SRCDS_BETAID} ]] || printf %s \"-beta ${SRCDS_BETAID}\" ) $( [[ -z ${SRCDS_BETAPASS} ]] || printf %s \"-betapassword ${SRCDS_BETAPASS}\" ) ${INSTALL_FLAGS} validate +quit; then break; fi\n    echo \"SteamCMD did not finish (attempt $steamcmd_try of 3)\"\ndone\n\n## set up 32 bit libraries\nmkdir -p /mnt/server/.steam/sdk32\ncp -v linux32/steamclient.so ../.steam/sdk32/steamclient.so\n\n## set up 64 bit libraries\nmkdir -p /mnt/server/.steam/sdk64\ncp -v linux64/steamclient.so ../.steam/sdk64/steamclient.so\n\n## Octail: fail the install when SteamCMD didn't download the server\nif [[ ! -f \"/mnt/server/Craftopia.x86_64\" ]]; then\n    echo -e \"\\nSteamCMD failed to install the Craftopia dedicated server; try reinstalling.\"\n    exit 1\nfi\nchmod +x /mnt/server/Craftopia.x86_64\n\ncd /mnt/server\nFILE=/mnt/server/ServerSetting.ini\nif [ -f \"$FILE\" ]; then\n    echo \"Config file exist\"\nelse \n    echo \"Config file does not exist, making one\"\n    cd /mnt/server\n    ## Octail: from a pinned commit; a failed download fails the install\n    curl -fsSL -o ServerSetting.ini https://raw.githubusercontent.com/pelican-eggs/games-steamcmd/8dd208975977aa24a6c53008a65a630c150806b8/craftopia/ServerSetting.ini || { rm -f ServerSetting.ini; echo \"Downloading ServerSetting.ini failed\"; exit 1; }\nfi\n\necho \"install finished\"",
      "container": "ghcr.io/sneakywrld/octail-yolks:installer_debian",
      "entrypoint": "bash"
    }
  },
